---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');

  return posts.map((post) => ({
    params: {
      slug: post.id,
    },
    props: {
      post,
    },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<!doctype html>
<html lang={post.data.lang === "zh-cn" ? "zh-CN" : post.data.lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{post.data.title} // NEXUS</title>

  <style>
    body {
      margin: 0;
      background: #05070a;
      color: #d7f9ff;
      font-family: monospace;
    }

    main {
      width: min(800px, calc(100% - 32px));
      margin: auto;
      padding: 50px 0;
    }

    a {
      color: #4ffcff;
    }

    .back {
      margin-bottom: 35px;
    }

    h1 {
      font-size: clamp(30px, 8vw, 55px);
    }

    .post-header {
      position: relative;
    }

    .edit-button {
      margin-right: 8px;
      padding: 8px 12px;
      border: 1px solid #4ffcff;
      background: transparent;
      color: #4ffcff;
      font-family: monospace;
      font-size: 12px;
      letter-spacing: 1px;
      cursor: pointer;
    }

    .edit-button:hover {
      background: #4ffcff;
      color: #05070a;
    }

    .delete-button {
      position: absolute;
      top: 0;
      right: 0;
      padding: 8px 12px;
      border: 1px solid #ff4f6d;
      background: transparent;
      color: #ff4f6d;
      font-family: monospace;
      font-size: 12px;
      letter-spacing: 1px;
      cursor: pointer;
    }

    .delete-button:hover {
      background: #ff4f6d;
      color: #05070a;
    }

    .date {
      color: #4ffcff;
      font-size: 12px;
    }

    article {
      line-height: 1.9;
      color: #b8d5da;
    }

    article h2,
    article h3 {
      color: #d7f9ff;
    }

    article code {
      padding: 3px 6px;
      background: #101a1f;
      color: #4ffcff;
    }

    article pre {
      overflow-x: auto;
      padding: 18px;
      background: #081015;
      border: 1px solid #153c43;
    }
  </style>
</head>

<body>
  <main>

    <div class="back">
      <a href="/">← RETURN TO ARCHIVE</a>
    </div>

    <div class="post-header">

      <button
        id="editArticle"
        class="edit-button"
        type="button"
      >
        ✎ EDIT
      </button>

      <button
        id="deleteArticle"
        class="delete-button"
        type="button"
      >
        🗑 DELETE
      </button>

      <div class="date">
        {post.data.pubDate.toLocaleDateString('zh-CN')}
          <span style="margin-left:10px;">{post.data.category || '未分类'}</span>
      </div>

      <h1>{post.data.title}</h1>

    </div>

    <article>
      <Content />
    </article>

  </main>

  <script define:vars={{ filename: post.id, title: post.data.title }}>
    const editButton =
      document.getElementById('editArticle');

    editButton.addEventListener('click', () => {
      const editUrl =
        `https://github.com/TOpenSource/TOpenSource.github.io/edit/main/src/content/posts/${encodeURIComponent(filename)}`;

      window.location.href = editUrl;
    });

    const deleteButton =
      document.getElementById('deleteArticle');

    deleteButton.addEventListener('click', () => {

      const confirmed = confirm(
        `DELETE THIS ARTICLE?\n\n${title}\n\nThis will create a GitHub deletion request.`
      );

      if (!confirmed) return;

      const issueTitle =
        `[NEXUS DELETE] ${title}`;

      const issueBody =
        `<!-- NEXUS_DELETE_START -->\n` +
        `NEXUS_FILENAME=${filename}\n` +
        `<!-- NEXUS_DELETE_END -->`;

      const url =
        'https://github.com/TOpenSource/TOpenSource.github.io/issues/new' +
        '?title=' + encodeURIComponent(issueTitle) +
        '&body=' + encodeURIComponent(issueBody);

      window.location.href = url;
    });
  </script>

</body>
</html>
