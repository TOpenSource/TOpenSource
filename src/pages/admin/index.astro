      background: #020607;

      color: #d8fff5;

      padding: 12px;

      outline: none;

      margin-top: 7px;

      font: inherit;
    }

    input:focus,
    textarea:focus {
      border-color: #40cdb4;
    }

    textarea {
      min-height: 360px;

      resize: vertical;

      font-family: monospace;

      line-height: 1.6;
    }

    label {
      display: block;

      margin-bottom: 15px;

      color: #73b9aa;

      font-size: 13px;
    }

    .grid {
      display: grid;

      grid-template-columns: 1fr 1fr;

      gap: 14px;
    }

    .preview {
      border: 1px dashed #17463f;

      padding: 18px;

      min-height: 360px;

      overflow-wrap: anywhere;
    }

    .preview h1,
    .preview h2,
    .preview h3 {
      color: #64ffe0;
    }

    .preview code {
      background: #071b19;

      border: 1px solid #17463f;

      padding: 2px 5px;

      color: #7dffe8;
    }

    .status {
      border-left: 3px solid #39d4b4;

      background: #071412;

      padding: 12px;

