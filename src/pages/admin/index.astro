        新文章使用「PUBLISH TO GITHUB」。
        编辑已有文章时使用「UPDATE GITHUB」。
        真正写入 GitHub 的操作由 GitHub Actions 完成。
      </div>

    </section>


    <!-- EDITOR AREA -->

    <section class="panel">

      <div class="grid">

        <div>

          <label>
            文件名

            <input
              id="filename"
              placeholder="my-first-article"
            />
          </label>


          <label>
            标题

            <input
              id="title"
              placeholder="文章 标题"
            />
          </label>


          <label>
            描述

            <input
              id="description"
              placeholder="文章简介"
            />
          </label>


          <label>
            标签

            <input
              id="tags"
              placeholder="NEXUS, SYSTEM, NOTE"
            />
          </label>


          <label>
            Markdown

            <textarea
              id="content"
              placeholder="# 你的文章

nano generate.py Markdown……"
            ></textarea>
          </label>

        </div>


        <div>

          <div class="hint">
            LIVE PREVIEW
          </div>

