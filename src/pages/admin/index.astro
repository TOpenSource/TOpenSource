<script>
import { pinyin } from 'pinyin-pro';

const KEY = 'nexus-admin-draft';

const filename =
  document.getElementById('filename');

const title =
  document.getElementById('title');

const description =
  document.getElementById('description');

const tags =
  document.getElementById('tags');

const content =
  document.getElementById('content');

const preview =
  document.getElementById('preview');

const status =
  document.getElementById('status');

const updateBtn =
  document.getElementById('updateBtn');

const publishBtn =
  document.getElementById('publishBtn');

const editingBadge =
  document.getElementById('editingBadge');


/*
 * ARTICLES GENERATED BY ASTRO
 */

const ARTICLES = JSON.parse(
  JSON.stringify(
    articleList
  )
);


/*
 * CURRENT EDITING STATE
 */

let editingSlug = '';


/*
 * STATUS
 */

function setStatus(text) {
  status.textContent = text;
}


/*
 * PINYIN SLUG
 */

function slugify(value) {

  const converted = pinyin(value, {
    toneType: 'none',
    type: 'string',
    nonZh: 'consecutive'
  });

  return converted
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}


/*
 * COLLECT
 */

function collect() {

  return {
    filename: filename.value.trim(),

    title: title.value.trim(),

    description:
      description.value.trim(),

    tags:
      tags.value.trim(),

    content:
      content.value
  };

}


/*
 * SAVE DRAFT
 */

function saveDraft() {

  localStorage.setItem(
    KEY,
    JSON.stringify(
      collect()
    )
  );

  setStatus('DRAFT SAVED');

}


/*
 * LOAD DRAFT
 */

function loadDraft() {

  const raw =
    localStorage.getItem(KEY);

  if (!raw) {
    return;
  }

  try {

    const data =
      JSON.parse(raw);

    filename.value =
      data.filename || '';

    title.value =
      data.title || '';

    description.value =
      data.description || '';

    tags.value =
      data.tags || '';

    content.value =
      data.content || '';

    updatePreview();

    setStatus('DRAFT LOADED');

  } catch {

    setStatus('DRAFT LOAD ERROR');

  }

}


/*
 * NEW ARTICLE
 */

function newArticle() {

  editingSlug = '';

  editingBadge.classList.add('hidden');

  updateBtn.classList.add('hidden');

  publishBtn.classList.remove('hidden');

  filename.value = '';

  title.value = '';

  description.value = '';

  tags.value = '';

  content.value = '';

  updatePreview();

  setStatus('NEW ARTICLE READY');

}


/*
 * LOAD ARTICLE INTO EDITOR
 */

function loadArticle(slug) {

  const article =
    ARTICLES.find(
      item => item.slug === slug
    );

  if (!article) {

    setStatus(
      'ERROR: ARTICLE NOT FOUND'
    );

    return;
  }


  editingSlug =
    article.slug;


  filename.value =
    article.slug;


  title.value =
    article.title || '';


  description.value =
    article.description || '';


  tags.value =
    (article.tags || []).join(', ');


  content.value =
    article.content || '';


  editingBadge.classList.remove(
    'hidden'
  );

  updateBtn.classList.remove(
    'hidden'
  );

  publishBtn.classList.add(
    'hidden'
  );


  updatePreview();

  setStatus(
    'ARTICLE LOADED: ' +
    article.title
  );


  window.scrollTo({
    top: document.body.scrollHeight,
    behavior: 'smooth'
  });

}


/*
 * ESCAPE HTML
 */

function escapeHtml(str) {

  return str
    .replaceAll(
      '&',
      '&amp;'
    )
    .replaceAll(
      '<',
      '&lt;'
    )
    .replaceAll(
      '>',
      '&gt;'
    )
    .replaceAll(
      '"',
      '&quot;'
    );

}


/*
 * SIMPLE MARKDOWN
 */

function simpleMarkdown(md) {

  let html =
    escapeHtml(md);


  html =
    html.replace(
      /^### (.*)$/gm,
      '<h3>$1</h3>'
    );


  html =
    html.replace(
      /^## (.*)$/gm,
      '<h2>$1</h2>'
    );


  html =
    html.replace(
      /^# (.*)$/gm,
      '<h1>$1</h1>'
    );


  html =
    html.replace(
      /\*\*(.*?)\*\*/g,
      '<strong>$1</strong>'
    );


  html =
    html.replace(
      /`([^`]+)`/g,
      '<code>$1</code>'
    );


  html =
    html.replace(
      /^- (.*)$/gm,
      '<li>$1</li>'
    );


  html =
    html.replace(
      /\n\n/g,
      '<br><br>'
    );


  html =
    html.replace(
      /\n/g,
      '<br>'
    );


  return html;

}


/*
 * PREVIEW
 */

function updatePreview() {

  preview.innerHTML =
    simpleMarkdown(
      content.value ||
      '暂无内容'
    );

}


/*
 * MARKDOWN GENERATOR
 */

function makeMarkdown() {

  const data =
    collect();


  const safeTitle =
    data.title.replaceAll(
      '"',
      '\\"'
    );


  const safeDescription =
    data.description.replaceAll(
      '"',
      '\\"'
    );


  const tagList =
    data.tags
      .split(',')
      .map(
        x => x.trim()
      )
      .filter(Boolean);


  let output =
    '---\n';


  output +=
    `title: "${safeTitle}"\n`;


  output +=
    `description: "${safeDescription}"\n`;


  output +=
    `pubDate: ${
      new Date()
        .toISOString()
        .slice(0, 10)
    }\n`;


  output +=
    'tags:\n';


  for (
    const tag of tagList
  ) {

    output +=
      `  - "${tag.replaceAll(
        '"',
        '\\"'
      )}"\n`;

  }


  output +=
    '---\n\n';


  output +=
    data.content;


  return output;

}


/*
 * CREATE GITHUB ISSUE
 */

function openGitHubIssue(
  issueTitle,
  body
) {

  const params =
    new URLSearchParams();


  params.set(
    'title',
    issueTitle
  );


  params.set(
    'body',
    body
  );


  const url =
    'https://github.com/TOpenSource/TOpenSource.github.io/issues/new?' +
    params.toString();


  const link =
    document.createElement('a');


  link.href =
    url;


  link.target =
    '_blank';


  link.rel =
    'noopener noreferrer';


  link.style.display =
    'none';


  document.body.appendChild(
    link
  );


  link.click();


  setTimeout(
    () => link.remove(),
    1000
  );

}


/*
 * PUBLISH
 */

window.publishToGitHub =
  function () {

    const data =
      collect();


    if (!data.title) {

      setStatus(
        'ERROR: TITLE REQUIRED'
      );

      return;

    }


    if (!data.content.trim()) {

      setStatus(
        'ERROR: CONTENT REQUIRED'
      );

      return;

    }


    let name =
      data.filename.trim();


    if (!name) {

      name =
        slugify(
          data.title
        );

    }


    if (!name) {

      setStatus(
        'ERROR: INVALID FILENAME'
      );

      return;

    }


    name =
      name.replace(
        /\.md$/i,
        ''
      );


    const body =
`<!-- NEXUS_PUBLISH_START -->
NEXUS_FILENAME=${name}
NEXUS_TITLE=${data.title.replace(/\n/g, ' ')}
NEXUS_DESCRIPTION=${data.description.replace(/\n/g, ' ')}
NEXUS_TAGS=${data.tags.replace(/\n/g, ' ')}
<!-- NEXUS_PUBLISH_END -->

<!-- NEXUS_CONTENT_START -->
${data.content}
<!-- NEXUS_CONTENT_END -->`;


    setStatus(
      'OPENING GITHUB PUBLISH TERMINAL...'
    );


    openGitHubIssue(
      '[NEXUS PUBLISH] ' +
      data.title,
      body
    );

  };


/*
 * UPDATE EXISTING ARTICLE
 */

function updateToGitHub() {

  if (!editingSlug) {

    setStatus(
      'ERROR: NO ARTICLE SELECTED'
    );

    return;

  }


  const data =
    collect();


  if (!data.title) {

    setStatus(
      'ERROR: TITLE REQUIRED'
    );

    return;

  }


  if (!data.content.trim()) {

    setStatus(
      'ERROR: CONTENT REQUIRED'
    );

    return;

  }


  const oldSlug =
    editingSlug;


  let newName =
    data.filename.trim();


  if (!newName) {

    newName =
      slugify(
        data.title
      );

  }


  newName =
    newName.replace(
      /\.md$/i,
      ''
    );


  if (!newName) {

    setStatus(
      'ERROR: INVALID FILENAME'
    );

    return;

  }


  const body =
`<!-- NEXUS_EDIT_START -->
NEXUS_OLD_FILENAME=${oldSlug}
NEXUS_FILENAME=${newName}
NEXUS_TITLE=${data.title.replace(/\n/g, ' ')}
NEXUS_DESCRIPTION=${data.description.replace(/\n/g, ' ')}
NEXUS_TAGS=${data.tags.replace(/\n/g, ' ')}
<!-- NEXUS_EDIT_END -->

<!-- NEXUS_CONTENT_START -->
${data.content}
<!-- NEXUS_CONTENT_END -->`;


  setStatus(
    'OPENING GITHUB EDIT TERMINAL...'
  );


  openGitHubIssue(
    '[NEXUS EDIT] ' +
    data.title,
    body
  );

}


/*
 * DELETE ARTICLE
 */

function deleteArticle(
  slug,
  articleTitle
) {

  if (!slug) {

    setStatus(
      'ERROR: INVALID ARTICLE'
    );

    return;

  }


  const confirmed =
    confirm(
      '⚠️ 确认删除？\n\n' +
      '《' +
      articleTitle +
      '》\n\n' +
      '文件：' +
      slug +
      '.md\n\n' +
      '此操作会从博客删除文章。\n\n' +
      '确定继续吗？'
    );


  if (!confirmed) {

    setStatus(
      'DELETE CANCELLED'
    );

    return;

  }


  const body =
`<!-- NEXUS_DELETE_START -->
NEXUS_FILENAME=${slug}
<!-- NEXUS_DELETE_END -->`;


  setStatus(
    'OPENING GITHUB DELETE TERMINAL...'
  );


  openGitHubIssue(
    '[NEXUS DELETE] ' +
    articleTitle,
    body
  );

}


/*
 * EXPORT MARKDOWN
 */

function exportMarkdown() {

  let name =
    filename.value.trim();


  if (!name) {

    name =
      slugify(
        title.value
      );

  }


  if (!name) {

    setStatus(
      'ERROR: PLEASE ENTER A TITLE'
    );

    return;

  }


  if (!name.endsWith('.md')) {

    name += '.md';

  }


  const blob =
    new Blob(
      [makeMarkdown()],
      {
        type:
          'text/markdown;charset=utf-8'
      }
    );


  const url =
    URL.createObjectURL(
      blob
    );


  const a =
    document.createElement('a');


  a.href =
    url;


  a.download =
    name;


  a.click();


  URL.revokeObjectURL(
    url
  );


  setStatus(
    `EXPORTED: ${name}`
  );

}


/*
 * ARTICLE MANAGER
 */

const articleListElement =
  document.getElementById('articleList');

const articleCountElement =
  document.getElementById('articleCount');

const articleSearch =
  document.getElementById('articleSearch');

const clearSearchBtn =
  document.getElementById('clearSearchBtn');

const searchStatus =
  document.getElementById('searchStatus');


function renderArticleList(keyword = '') {

  const query =
    keyword.trim().toLowerCase();

  const results =
    ARTICLES.filter(article => {

      if (!query) {
        return true;
      }

      const searchable = [
        article.title,
        article.slug,
        article.description,
        ...(article.tags || [])
      ]
        .join(' ')
        .toLowerCase();

      return searchable.includes(query);

    });


  articleCountElement.textContent =
    results.length;


  if (query) {

    searchStatus.textContent =
      `搜索「${keyword}」：找到 ${results.length} 篇文章`;

  } else {

    searchStatus.textContent =
      `显示全部 ${results.length} 篇文章`;

  }


  if (!results.length) {

    articleListElement.innerHTML = `
      <div class="empty">
        NO MATCHING ARTICLES
        <br><br>
        没有找到匹配的文章
      </div>
    `;

    return;

  }


  articleListElement.innerHTML =
    results.map(article => `

      <div
        class="article-card"
        data-slug="${escapeHtml(article.slug)}"
      >

        <div class="article-main">

          <div class="article-info">

            <div class="article-title">
              ${escapeHtml(article.title)}
            </div>

            <div class="article-slug">
              ${escapeHtml(article.slug)}.md
            </div>

            ${
              article.description
                ? `
                  <div class="article-description">
                    ${escapeHtml(
                      article.description
                    )}
                  </div>
                `
                : ''
            }

            <div class="article-meta">

              ${escapeHtml(
                article.pubDate || ''
              )}

              ${
                article.tags?.length
                  ? ' · ' +
                    article.tags
                      .map(
                        tag => '#' + tag
                      )
                      .join(' ')
                  : ''
              }

            </div>

          </div>


          <div class="article-actions">

            <button
              type="button"
              class="edit-button"
              data-action="edit"
              data-slug="${escapeHtml(
                article.slug
              )}"
            >
              ✎ EDIT
            </button>

            <button
              type="button"
              class="danger"
              data-action="delete"
              data-slug="${escapeHtml(
                article.slug
              )}"
              data-title="${escapeHtml(
                article.title
              )}"
            >
              🗑 DELETE
            </button>

          </div>

        </div>

      </div>

    `).join('');


  articleListElement
    .querySelectorAll(
      '[data-action="edit"]'
    )
    .forEach(button => {

      button.addEventListener(
        'click',
        () => {

          loadArticle(
            button.dataset.slug
          );

        }
      );

    });


  articleListElement
    .querySelectorAll(
      '[data-action="delete"]'
    )
    .forEach(button => {

      button.addEventListener(
        'click',
        () => {

          deleteArticle(
            button.dataset.slug,
            button.dataset.title
          );

        }
      );

    });

}


articleSearch.addEventListener(
  'input',
  () => {

    renderArticleList(
      articleSearch.value
    );

  }
);


clearSearchBtn.addEventListener(
  'click',
  () => {

    articleSearch.value = '';

    renderArticleList('');

    articleSearch.focus();

  }
);


renderArticleList('');

/*
 * REFRESH
 */

document
  .getElementById(
    'refreshManagerBtn'
  )
  .addEventListener(
    'click',
    () => {

      location.reload();

    }
  );


/*
 * NEW
 */

document
  .getElementById(
    'newBtn'
  )
  .addEventListener(
    'click',
    newArticle
  );


/*
 * SAVE DRAFT
 */

document
  .getElementById(
    'saveBtn'
  )
  .addEventListener(
    'click',
    saveDraft
  );


/*
 * PREVIEW
 */

document
  .getElementById(
    'previewBtn'
  )
  .addEventListener(
    'click',
    () => {

      preview.classList.remove(
        'hidden'
      );

      updatePreview();

      setStatus(
        'PREVIEW MODE'
      );

    }
  );


/*
 * EDIT MODE
 */

document
  .getElementById(
    'editBtn'
  )
  .addEventListener(
    'click',
    () => {

      content.focus();

      setStatus(
        'EDIT MODE'
      );

    }
  );


/*
 * EXPORT
 */

document
  .getElementById(
    'exportBtn'
  )
  .addEventListener(
    'click',
    exportMarkdown
  );


/*
 * UPDATE
 */

updateBtn.addEventListener(
  'click',
  updateToGitHub
);


/*
 * CLEAR
 */

document
  .getElementById(
    'clearBtn'
  )
  .addEventListener(
    'click',
    () => {

      if (
        confirm(
          '确定清空当前文章？'
        )
      ) {

        newArticle();

        localStorage.removeItem(
          KEY
        );

        setStatus(
          'EDITOR CLEARED'
        );

      }

    }
  );


/*
 * LIVE PREVIEW
 */

content.addEventListener(
  'input',
  updatePreview
);


/*
 * AUTO PINYIN
 */

title.addEventListener(
  'input',
  () => {

    if (
      !filename.value.trim() &&
      !editingSlug
    ) {

      filename.value =
        slugify(
          title.value
        );

    }

  }
);


/*
 * INITIALIZE
 */

loadDraft();

updatePreview();

</script>

</body>
</html>
