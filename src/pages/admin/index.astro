---
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>NEXUS // ADMIN</title>

  <style>
    :global(*) {
      box-sizing: border-box;
    }

    :global(body) {
      margin: 0;
      min-height: 100vh;
      background:
        linear-gradient(rgba(0,255,200,.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,255,200,.035) 1px, transparent 1px),
        #05080b;
      background-size: 32px 32px;
      color: #d8fff5;
      font-family: Arial, sans-serif;
    }

    .wrap {
      width: min(1100px, calc(100% - 28px));
      margin: auto;
      padding: 28px 0 60px;
    }

    header {
      border: 1px solid #17463f;
      background: rgba(4,15,17,.88);
      padding: 22px;
      margin-bottom: 18px;
    }

    .logo {
      font-size: 28px;
      font-weight: 800;
      letter-spacing: 5px;
      color: #64ffe0;
    }

    .sub {
      margin-top: 8px;
      color: #6d9d94;
      font-size: 12px;
      letter-spacing: 2px;
    }

    .panel {
      border: 1px solid #17463f;
      background: rgba(4,15,17,.92);
      padding: 18px;
      margin-bottom: 18px;
    }

    .toolbar {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 16px;
    }

    button {
      border: 1px solid #1d7566;
      background: #081b1b;
      color: #73ffe2;
      padding: 10px 16px;
      cursor: pointer;
      font-weight: 700;
    }

    button:hover {
      background: #0d302d;
    }

    .danger {
      border-color: #784242;
      color: #ff8c8c;
    }

    input, textarea {
      width: 100%;
      border: 1px solid #17463f;
      background: #020607;
      color: #d8fff5;
      padding: 12px;
      outline: none;
      margin-top: 7px;
      font: inherit;
    }

    input:focus, textarea:focus {
      border-color: #40cdb4;
    }

    textarea {
      min-height: 360px;
      resize: vertical;
      font-family: monospace;
      line-height: 1.6;
    }

    label {
      display: block;
      margin-bottom: 15px;
      color: #73b9aa;
      font-size: 13px;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .preview {
      border: 1px dashed #17463f;
      padding: 18px;
      min-height: 360px;
      overflow-wrap: anywhere;
    }

    .preview h1,
    .preview h2,
    .preview h3 {
      color: #64ffe0;
    }

    .status {
      border-left: 3px solid #39d4b4;
      background: #071412;
      padding: 12px;
      margin-top: 15px;
      color: #8cebd9;
      font-size: 13px;
      white-space: pre-wrap;
    }

    .hint {
      color: #61847e;
      font-size: 12px;
      line-height: 1.7;
    }

    .hidden {
      display: none;
    }

    @media (max-width: 700px) {
      .grid {
        grid-template-columns: 1fr;
      }

      .logo {
        font-size: 22px;
      }

      textarea {
        min-height: 300px;
      }
    }
  </style>
</head>

<body>
  <main class="wrap">

    <header>
      <div class="logo">NEXUS // ADMIN</div>
      <div class="sub">PERSONAL KNOWLEDGE ARCHIVE · CONTROL TERMINAL</div>
    </header>

    <section class="panel">
      <div class="toolbar">
        <button id="newBtn">＋ NEW ARTICLE</button>
        <button id="saveBtn">💾 SAVE DRAFT</button>
        <button id="previewBtn">👁 PREVIEW</button>
        <button id="editBtn">✎ EDIT</button>
        <button id="exportBtn">⬇ EXPORT MARKDOWN</button>
        <button id="publishBtn">🚀 PUBLISH TO GITHUB</button>
        <button id="clearBtn" class="danger">CLEAR</button>
      </div>

      <div class="hint">
        编辑完成后点击「EXPORT MARKDOWN」可以直接生成文章文件。
        真正写入 GitHub 的操作仍由 GitHub Actions 完成，不在浏览器中保存 Token。
      </div>
    </section>

    <section class="panel">
      <div class="grid">

        <div>
          <label>
            文件名
            <input id="filename" placeholder="my-first-article" />
          </label>

          <label>
            标题
            <input id="title" placeholder="文章标题" />
          </label>

          <label>
            描述
            <input id="description" placeholder="文章简介" />
          </label>

          <label>
            标签
            <input id="tags" placeholder="NEXUS, SYSTEM, NOTE" />
          </label>

          <label>
            Markdown
            <textarea id="content" placeholder="# 你的文章

nano generate.py Markdown……"></textarea>
          </label>
        </div>

        <div>
          <div class="hint">LIVE PREVIEW</div>
          <div id="preview" class="preview"></div>
        </div>

      </div>

      <div id="status" class="status">SYSTEM READY</div>
    </section>

  </main>

<script>
const KEY = 'nexus-admin-draft';

const filename = document.getElementById('filename');
const title = document.getElementById('title');
const description = document.getElementById('description');
const tags = document.getElementById('tags');
const content = document.getElementById('content');
const preview = document.getElementById('preview');
const status = document.getElementById('status');

function setStatus(text) {
  status.textContent = text;
}

function slugify(value) {
  return value
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9\u4e00-\u9fff]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

function collect() {
  return {
    filename: filename.value.trim(),
    title: title.value.trim(),
    description: description.value.trim(),
    tags: tags.value.trim(),
    content: content.value
  };
}

function saveDraft() {
  localStorage.setItem(KEY, JSON.stringify(collect()));
  setStatus('DRAFT SAVED');
}

function loadDraft() {
  const raw = localStorage.getItem(KEY);

  if (!raw) {
    return;
  }

  try {
    const data = JSON.parse(raw);

    filename.value = data.filename || '';
    title.value = data.title || '';
    description.value = data.description || '';
    tags.value = data.tags || '';
    content.value = data.content || '';

    updatePreview();
    setStatus('DRAFT LOADED');
  } catch {
    setStatus('DRAFT LOAD ERROR');
  }
}

function newArticle() {
  filename.value = '';
  title.value = '';
  description.value = '';
  tags.value = '';
  content.value = '';

  updatePreview();
  setStatus('NEW ARTICLE READY');
}

function escapeHtml(str) {
  return str
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;');
}

function simpleMarkdown(md) {
  let html = escapeHtml(md);

  html = html.replace(/^### (.*)$/gm, '<h3>$1</h3>');
  html = html.replace(/^## (.*)$/gm, '<h2>$1</h2>');
  html = html.replace(/^# (.*)$/gm, '<h1>$1</h1>');
  html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
  html = html.replace(/`([^`]+)`/g, '<code>$1</code>');
  html = html.replace(/^- (.*)$/gm, '<li>$1</li>');
  html = html.replace(/\n\n/g, '<br><br>');
  html = html.replace(/\n/g, '<br>');

  return html;
}

function updatePreview() {
  preview.innerHTML = simpleMarkdown(content.value || '暂无内容');
}

function makeMarkdown() {
  const data = collect();

  const safeTitle = data.title.replaceAll('"', '\\"');
  const safeDescription = data.description.replaceAll('"', '\\"');

  const tagList = data.tags
    .split(',')
    .map(x => x.trim())
    .filter(Boolean);

  let output = '---\n';

  output += `title: "${safeTitle}"\n`;
  output += `description: "${safeDescription}"\n`;
  output += `pubDate: ${new Date().toISOString().slice(0, 10)}\n`;
  output += 'tags:\n';

  for (const tag of tagList) {
    output += `  - "${tag.replaceAll('"', '\\"')}"\n`;
  }

  output += '---\n\n';
  output += data.content;

  return output;
}


function publishToGitHub() {
  const data = collect();

  if (!data.title) {
    setStatus('ERROR: TITLE REQUIRED');
    return;
  }

  if (!data.content.trim()) {
    setStatus('ERROR: CONTENT REQUIRED');
    return;
  }

  let name = data.filename.trim();

  if (!name) {
    name = slugify(data.title);
  }

  if (!name) {
    setStatus('ERROR: INVALID FILENAME');
    return;
  }

  name = name.replace(/\.md$/i, '');

  const body =
`<!-- NEXUS_PUBLISH_START -->
NEXUS_FILENAME=${name}
NEXUS_TITLE=${data.title.replace(/\n/g, ' ')}
NEXUS_DESCRIPTION=${data.description.replace(/\n/g, ' ')}
NEXUS_TAGS=${data.tags.replace(/\n/g, ' ')}
<!-- NEXUS_PUBLISH_END -->

<!-- NEXUS_CONTENT_START -->
${data.content}
<!-- NEXUS_CONTENT_END -->`;

  const params = new URLSearchParams();

  params.set('title', '[NEXUS PUBLISH] ' + data.title);
  params.set('body', body);

  const url =
    'https://github.com/TOpenSource/TOpenSource/issues/new?' +
    params.toString();

  setStatus('OPENING GITHUB PUBLISH TERMINAL...');

  window.location.href = url;
}

function exportMarkdown() {
  let name = filename.value.trim();

  if (!name) {
    name = slugify(title.value);
  }

  if (!name) {
    setStatus('ERROR: PLEASE ENTER A TITLE');
    return;
  }

  if (!name.endsWith('.md')) {
    name += '.md';
  }

  const blob = new Blob(
    [makeMarkdown()],
    { type: 'text/markdown;charset=utf-8' }
  );

  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');

  a.href = url;
  a.download = name;
  a.click();

  URL.revokeObjectURL(url);

  setStatus(`EXPORTED: ${name}`);
}

document.getElementById('newBtn').addEventListener('click', newArticle);

document.getElementById('saveBtn').addEventListener('click', saveDraft);

document.getElementById('previewBtn').addEventListener('click', () => {
  preview.classList.remove('hidden');
  updatePreview();
  setStatus('PREVIEW MODE');
});

document.getElementById('editBtn').addEventListener('click', () => {
  content.focus();
  setStatus('EDIT MODE');
});

document.getElementById('exportBtn').addEventListener('click', exportMarkdown);

document.getElementById('publishBtn').addEventListener('click', publishToGitHub);

document.getElementById('clearBtn').addEventListener('click', () => {
  if (confirm('确定清空当前文章？')) {
    newArticle();
    localStorage.removeItem(KEY);
    setStatus('EDITOR CLEARED');
  }
});

content.addEventListener('input', updatePreview);

title.addEventListener('input', () => {
  if (!filename.value.trim()) {
    filename.value = slugify(title.value);
  }
});

loadDraft();
updatePreview();
</script>

</body>
</html>
