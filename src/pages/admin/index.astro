    /* ARTICLE MANAGER */

    .manager-header {
      display: flex;

      justify-content: space-between;

      align-items: center;

      gap: 10px;

      flex-wrap: wrap;

      margin-bottom: 14px;
    }

    .manager-title {
      color: #64ffe0;

