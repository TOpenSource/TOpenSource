      font-weight: 800;

      letter-spacing: 2px;
    }

    .article-count {
      color: #61847e;

      font-size: 12px;
    }

    .article-list {
      display: flex;

      flex-direction: column;

      gap: 10px;
    }

    .article-card {
      border: 1px solid #17463f;

      background: rgba(2,8,9,.75);

      padding: 14px;
    }

    .article-card:hover {
      border-color: #286f62;
    }

    .article-main {
      display: flex;

      justify-content: space-between;

      gap: 14px;

      align-items: flex-start;
    }

    .article-info {
      min-width: 0;

      flex: 1;
    }

    .article-title {
      color: #d8fff5;

      font-size: 16px;

      font-weight: 700;

      margin-bottom: 6px;
    }

    .article-slug {
      color: #4e8077;

      font-family: monospace;

      font-size: 12px;

      word-break: break-all;
    }

    .article-description {
      color: #71948e;

      font-size: 12px;

      margin-top: 7px;

      line-height: 1.5;
    }

    .article-meta {
      color: #52736d;

      font-size: 11px;

      margin-top: 8px;
    }

    .article-actions {
      display: flex;

      gap: 7px;

      flex-wrap: wrap;

      justify-content: flex-end;
    }

    .article-actions button {
      padding: 7px 10px;

      font-size: 12px;
    }

    .empty {
      border: 1px dashed #17463f;

      padding: 25px;

      text-align: center;

      color: #61847e;
    }

    .editing-badge {
      display: inline-block;

      border: 1px solid #756d1d;

      color: #ffe873;

      padding: 4px 8px;

      font-size: 11px;

      margin-bottom: 12px;
    }

    @media (max-width: 700px) {
      .grid {
        grid-template-columns: 1fr;
      }

      .logo {
        font-size: 22px;
      }

      textarea {
        min-height: 300px;
      }

      .article-main {
        flex-direction: column;
      }

      .article-actions {
        justify-content: flex-start;
      }
    }
  </style>
</head>

<body>

  <main class="wrap">

    <header>
      <div class="logo">NEXUS // ADMIN</div>

      <div class="sub">
        PERSONAL KNOWLEDGE ARCHIVE · CONTROL TERMINAL
      </div>
    </header>


    <!-- ARTICLE MANAGER -->

<section class="panel">

  <div class="manager-header">

    <div>
      <div class="manager-title">
        📚 ARTICLE MANAGER
      </div>

      <div class="article-count">
        <span id="articleCount">0</span>
        / 0 ARTICLES
