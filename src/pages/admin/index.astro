---
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const posts = await getCollection('posts');

const articleList = posts.map((post) => ({
  id: post.id,
  slug: post.id.replace(/\.md$/i, ''),
  title: post.data.title,
  description: post.data.description || '',
  pubDate: post.data.pubDate
    ? post.data.pubDate.toISOString().slice(0, 10)
    : '',
  tags: post.data.tags || [],
  content: post.body || ''
}));
---

<!doctype html>
<html lang="zh-CN">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>NEXUS // ADMIN</title>

  <style>
    :global(*) {
      box-sizing: border-box;
    }

    :global(body) {
      margin: 0;
      min-height: 100vh;

      background:
        linear-gradient(rgba(0,255,200,.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,255,200,.035) 1px, transparent 1px),
        #05080b;

      background-size: 32px 32px;

      color: #d8fff5;

      font-family: Arial, sans-serif;
    }

    .wrap {
      width: min(1100px, calc(100% - 28px));
      margin: auto;
      padding: 28px 0 60px;
    }

    header {
      border: 1px solid #17463f;
      background: rgba(4,15,17,.88);

      padding: 22px;
      margin-bottom: 18px;
    }

    .logo {
      font-size: 28px;
      font-weight: 800;
      letter-spacing: 5px;
      color: #64ffe0;
    }

    .sub {
      margin-top: 8px;

      color: #6d9d94;

      font-size: 12px;
      letter-spacing: 2px;
    }

    .panel {
      border: 1px solid #17463f;
      background: rgba(4,15,17,.92);

