    }

    .toolbar {
      display: flex;

      gap: 10px;

      flex-wrap: wrap;

      margin-bottom: 16px;
    }

    button {
      border: 1px solid #1d7566;

      background: #081b1b;

      color: #73ffe2;

      padding: 10px 16px;

