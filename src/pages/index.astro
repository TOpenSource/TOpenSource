---
import KeepAndroidOpen from '../components/KeepAndroidOpen.astro';
import NexusPopup from '../components/NexusPopup.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
---

<!doctype html>
<html lang="zh-CN" data-language="zh-cn">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>NEXUS // ARCHIVE</title>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background:
        linear-gradient(rgba(0,255,255,.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,255,255,.035) 1px, transparent 1px),
        #05070a;
      background-size: 32px 32px;
      color: #d8ffff;
      font-family: monospace;
    }

    .wrap {
      width: min(1000px, 92%);
      margin: auto;
      padding: 50px 0;
    }

    header {
      border: 1px solid #164d55;
      padding: 28px;
      background: rgba(0,20,25,.72);
      box-shadow: 0 0 30px rgba(0,255,255,.06);
    }

    .system {
      color: #00ffff;
      font-size: 12px;
      letter-spacing: 3px;
    }

    h1 {
      margin: 12px 0 4px;
      color: #00ffff;
      font-size: clamp(32px, 8vw, 64px);
      letter-spacing: 5px;
      text-shadow: 0 0 18px rgba(0,255,255,.4);
    }

    .subtitle {
      color: #71969b;
      letter-spacing: 3px;
    }

    .search {
      display: flex;
      gap: 10px;
      margin-top: 28px;
    }

    input {
      flex: 1;
      min-width: 0;
      padding: 15px;
      border: 1px solid #17606a;
      background: #020507;
      color: #d8ffff;
      outline: none;
      font: inherit;
    }

    button {
      padding: 0 20px;
      border: 1px solid #00ffff;
      background: #003337;
      color: #00ffff;
      font: inherit;
      cursor: pointer;
    }

    .sort-bar {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 12px 0 18px;
      font-size: 12px;
      letter-spacing: 1px;
    }

    .sort-bar select {
      padding: 7px 10px;
      border: 1px solid currentColor;
      background: transparent;
      color: inherit;
      font: inherit;
      letter-spacing: 1px;
      cursor: pointer;
    }

    .count {
      margin: 35px 0 15px;
      color: #54777c;
      font-size: 13px;
    }

    .post {
      display: block;
      padding: 24px;
      margin: 14px 0;
      border: 1px solid #143d44;
      background: rgba(0,15,20,.65);
      text-decoration: none;
      color: inherit;
      transition: .2s;
    }

    .post:hover {
      border-color: #00ffff;
      box-shadow: 0 0 20px rgba(0,255,255,.08);
      transform: translateY(-2px);
    }

    .date {
      color: #00aeb8;
      font-size: 12px;
    }

    h2 {
      color: #00ffff;
      margin: 10px 0;
    }

    .desc {
      color: #8aaeb2;
      line-height: 1.7;
    }

    .comment-count {
      margin-top: 12px;
      color: #4ffcff;
      font-family: monospace;
      font-size: 12px;
      letter-spacing: 1px;
    }

    .tags {
      margin-top: 15px;
    }

    .tag {
      display: inline-block;
      margin-right: 8px;
      padding: 4px 8px;
      border: 1px solid #20565d;
      color: #6edce3;
      font-size: 11px;
    }

    .empty {
      padding: 30px;
      border: 1px dashed #27565d;
      color: #66898d;
    }

    @media (max-width: 600px) {
      .wrap {
        padding: 25px 0;
      }

      header {
        padding: 20px;
      }

      .search {
        flex-direction: column;
      }

      button {
        min-height: 45px;
      }

      .post {
        padding: 18px;
      }
    }
  </style>
</head>

<body>
  <NexusPopup />
  <KeepAndroidOpen />
  <main class="wrap">

    <header>
      <div class="system">SYSTEM STATUS // ONLINE</div>
      <h1>NEXUS</h1>
      <div class="subtitle">PERSONAL KNOWLEDGE ARCHIVE</div>

      <div class="search">
        <input id="search" type="search" placeholder="SEARCH ARCHIVE..." />
        <select id="categoryFilter">
          <option value="">ALL CATEGORIES / 全部分类</option>
          {Array.from(
            new Set(posts.map((post) => post.data.category || '未分类'))
          )
            .sort((a, b) => a.localeCompare(b, 'zh-CN'))
            .map((category) => (
              <option value={category}>{category}</option>
            ))}
        </select>
        <button id="scan">SCAN</button>
      </div>
    </header>
<div class="count" id="count">
      ARCHIVE RECORDS: {posts.length}
    </div>

    <div class="sort-bar">
      <label for="postSort">SORT:</label>
      <select id="postSort">
        <option value="newest">NEWEST / 最新发布</option>
        <option value="oldest">OLDEST / 最早发布</option>
        <option value="az">TITLE A-Z</option>
        <option value="za">TITLE Z-A</option>
      </select>
    </div>


    <section id="posts">
      {posts.length === 0 ? (
        <div class="empty">NO ARCHIVE RECORDS FOUND.</div>
      ) : (
        posts.map((post) => (
          <a
            class="post"
            href={`/posts/${post.id}/`}
            data-search={`${post.data.title} ${post.data.description ?? ''} ${post.data.tags.join(' ')}`}
            data-date={post.data.pubDate.toISOString()}
            data-title={post.data.title}
            data-category={post.data.category || '未分类'}
          >
            <div class="date">
              {post.data.pubDate.toLocaleDateString('zh-CN')}
            </div>

            <h2>{post.data.title}</h2>

            {post.data.description && (
              <div class="desc">{post.data.description}</div>
            )}

            <div class="tags">
              {post.data.tags.map((tag) => (
                <span class="tag">#{tag}</span>
              ))}
            </div>

            <div class="comment-count"
              data-path={`/posts/${post.id}/`}>
              💬 Loading comments...
            </div>
          </a>
        ))
      )}
    </section>

  </main>

  <script>
    const input = document.querySelector('#search');
    const postsContainer = document.querySelector('#posts');
    const posts = [...document.querySelectorAll('.post')];
    const count = document.querySelector('#count');
    const sortSelect = document.querySelector('#postSort');
    const categoryFilter = document.querySelector('#categoryFilter');

    function sortPosts() {
      const mode = sortSelect.value;

      posts.sort((a, b) => {
        // ISO 日期字符串 YYYY-MM-DD / ISO 时间可以直接比较。
        // 不使用 new Date()，避免时区造成排序偏差。
        const dateA = a.dataset.date || '';
        const dateB = b.dataset.date || '';

        const titleA = a.dataset.title || '';
        const titleB = b.dataset.title || '';

        const categoryA = a.dataset.category || '未分类';
        const categoryB = b.dataset.category || '未分类';

        if (mode === 'newest') {
          // 最新：日期降序
          if (dateA !== dateB) {
            return dateB.localeCompare(dateA);
          }

          // 日期相同：标题升序，保证稳定
          const titleCompare = titleA.localeCompare(
            titleB,
            'zh-CN'
          );

          if (titleCompare !== 0) {
            return titleCompare;
          }

          // 标题也相同：分类升序
          return categoryA.localeCompare(
            categoryB,
            'zh-CN'
          );
        }

        if (mode === 'oldest') {
          // 最早：日期升序
          if (dateA !== dateB) {
            return dateA.localeCompare(dateB);
          }

          // 日期相同：标题升序
          const titleCompare = titleA.localeCompare(
            titleB,
            'zh-CN'
          );

          if (titleCompare !== 0) {
            return titleCompare;
          }

          // 标题也相同：分类升序
          return categoryA.localeCompare(
            categoryB,
            'zh-CN'
          );
        }

        if (mode === 'az') {
          const titleCompare = titleA.localeCompare(
            titleB,
            'zh-CN'
          );

          if (titleCompare !== 0) {
            return titleCompare;
          }

          const categoryCompare = categoryA.localeCompare(
            categoryB,
            'zh-CN'
          );

          if (categoryCompare !== 0) {
            return categoryCompare;
          }

          return dateB.localeCompare(dateA);
        }

        if (mode === 'za') {
          const titleCompare = titleB.localeCompare(
            titleA,
            'zh-CN'
          );

          if (titleCompare !== 0) {
            return titleCompare;
          }

          const categoryCompare = categoryA.localeCompare(
            categoryB,
            'zh-CN'
          );

          if (categoryCompare !== 0) {
            return categoryCompare;
          }

          return dateB.localeCompare(dateA);
        }

        return 0;
      });

      // 排序后重新插入 DOM。
      // 这一步决定页面实际显示顺序。
      posts.forEach((post) => {
        postsContainer.appendChild(post);
      });
    }

    function search() {
      const keyword = input.value.toLowerCase().trim();
      const category = categoryFilter.value;

      let visible = 0;

      posts.forEach((post) => {
        const text = post.dataset.search.toLowerCase();

        const matchKeyword =
          !keyword || text.includes(keyword);

        const matchCategory =
          !category || post.dataset.category === category;

        const match =
          matchKeyword && matchCategory;

        post.style.display =
          match ? 'block' : 'none';

        if (match) visible++;
      });

      count.textContent =
        `ARCHIVE RECORDS: ${visible}`;
    }

    sortSelect.addEventListener('change', () => {
      sortPosts();
      search();
    });

    input.addEventListener('input', search);
    categoryFilter.addEventListener('change', search);
    document.querySelector('#scan').addEventListener('click', search);

    // 默认：最新文章在最上面
    sortPosts();
  </script>


<script>
async function loadCommentCounts() {

  const items =
    document.querySelectorAll('.comment-count');

  for (const item of items) {

    const pathname =
      item.dataset.path;

    try {

      const res =
        await fetch(
          "https://api.github.com/graphql",
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({
              query: `
              query {
                repository(
                  owner:"TOpenSource",
                  name:"TOpenSource.github.io"
                ) {
                  discussions(first:100) {
                    nodes {
                      title
                      comments {
                        totalCount
                      }
                    }
                  }
                }
              }`
            })
          }
        );

      const json = await res.json();

      const list =
        json.data.repository.discussions.nodes;

      const found =
        list.find(
          d => d.title.includes(pathname)
        );

      item.textContent =
        found
        ? "💬 " + found.comments.totalCount + " COMMENTS"
        : "💬 0 COMMENTS";

    } catch(e) {

      item.textContent =
        "💬 COMMENTS";

    }
  }
}

loadCommentCounts();
</script>

</body>
</html>
