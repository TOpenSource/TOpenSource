<div class="announcement">

  <button id="announcementBtn">
    📢 ANNOUNCEMENT / 公告
  </button>

  <div id="announcementBox" class="box">

    <div class="title">
      📢 ANNOUNCEMENT / 公告
    </div>

    <div class="content">
      Welcome to NEXUS Archive.<br>
      欢迎来到 NEXUS 知识库。
      <br><br>
      This is an announcement area.<br>
      这里可以发布网站公告。
    </div>

    <button id="closeAnnouncement">
      CLOSE / 关闭
    </button>

  </div>

</div>


<style>

.announcement {
  position: fixed;
  right: 20px;
  bottom: 20px;
  z-index: 9999;
}

#announcementBtn {

  background:#05070a;
  color:#00ffff;

  border:1px solid #00ffff;

  padding:10px 16px;

  cursor:pointer;

  font-size:14px;

  letter-spacing:1px;

}


.box {

  display:none;

  width:320px;

  margin-bottom:12px;

  padding:20px;

  background:#05070a;

  border:1px solid #00ffff;

  color:#d8ffff;

  box-shadow:
  0 0 20px rgba(0,255,255,.25);

}


.title {

  color:#00ffff;

  margin-bottom:15px;

  font-size:16px;

}


.content {

  line-height:1.7;

}


#closeAnnouncement {

  margin-top:15px;

  background:transparent;

  color:#00ffff;

  border:1px solid #00ffff;

  padding:6px 12px;

  cursor:pointer;

}


</style>


<script>

const btn =
document.getElementById(
  "announcementBtn"
);

const box =
document.getElementById(
  "announcementBox"
);

const close =
document.getElementById(
  "closeAnnouncement"
);


btn?.addEventListener(
"click",
()=>{

 box.style.display =
 box.style.display === "block"
 ? "none"
 : "block";

});


close?.addEventListener(
"click",
()=>{

 box.style.display="none";

});


document.addEventListener(
"keydown",
(e)=>{

 if(e.key==="Escape"){
   box.style.display="none";
 }

});


</script>
