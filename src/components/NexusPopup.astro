<div class="announcement">

  <button id="announcementBtn">
    📢 ANNOUNCEMENT / 公告
  </button>


  <div id="overlay">

    <div class="box">

      <div class="title">
        📢 ANNOUNCEMENT / 公告
      </div>


      <div class="content">

        🚀 NEXUS BLOG UPDATE
        <br><br>

        EN: New features have been added.
        <br>
        CN: 博客新增功能已上线。
        <br><br>

        • Comment system enabled
        <br>
        • TOC navigation added
        <br>
        • More features coming soon

      </div>


      <button id="closeAnnouncement">
        CLOSE / 关闭
      </button>


    </div>

  </div>


</div>


<style>

.announcement {

  position: fixed;

  right:20px;
  bottom:20px;

  z-index:9999;

}


#announcementBtn {

  background:#05070a;

  color:#00ffff;

  border:1px solid #00ffff;

  padding:10px 16px;

  cursor:pointer;

}


#overlay {

  display:none;

  position:fixed;

  inset:0;

  background:
  rgba(0,0,0,.75);

  z-index:10000;

  align-items:center;

  justify-content:center;

}


.box {

  width:min(90vw,420px);

  max-height:80vh;

  overflow:auto;

  padding:25px;

  background:#05070a;

  border:1px solid #00ffff;

  color:#d8ffff;

  box-shadow:
  0 0 30px rgba(0,255,255,.3);

}


.title {

  color:#00ffff;

  font-size:18px;

  margin-bottom:20px;

}


.content {

  line-height:1.8;

}


#closeAnnouncement {

  margin-top:20px;

  padding:8px 16px;

  background:none;

  color:#00ffff;

  border:1px solid #00ffff;

  cursor:pointer;

}


</style>


<script>

const btn =
document.getElementById(
"announcementBtn"
);


const overlay =
document.getElementById(
"overlay"
);


const close =
document.getElementById(
"closeAnnouncement"
);


btn?.addEventListener(
"click",
()=>{

 overlay.style.display="flex";

});


close?.addEventListener(
"click",
()=>{

 overlay.style.display="none";

});


overlay?.addEventListener(
"click",
(e)=>{

 if(e.target===overlay){

  overlay.style.display="none";

 }

});


document.addEventListener(
"keydown",
(e)=>{

 if(e.key==="Escape"){

  overlay.style.display="none";

 }

});


</script>
